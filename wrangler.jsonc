{
  // LET OP: "name" moet exact gelijk zijn aan de projectnaam in het
  // Cloudflare-dashboard (Workers & Pages), anders maakt een deploy een
  // tweede, los project aan.
  "name": "global-prototypes",
  "compatibility_date": "2026-08-01",
  "main": "worker.js",
  // Keep-alive voor het Supabase-project achter docs/casar-dashboard/
  // datatabel.html: de gratis tier pauzeert na 7 dagen zonder gebruik.
  // Twee pings per week (ma en do 08:00 UTC) houden ruime marge.
  // Dagnamen i.p.v. nummers: Cloudflare telt dagnummers anders dan
  // standaard cron (1 = zondag), dagnamen zijn ondubbelzinnig.
  "triggers": {
    "crons": ["0 8 * * MON,THU"]
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    // Alle requests gaan eerst door worker.js (wachtwoordcheck),
    // pas daarna worden de statische bestanden geserveerd.
    "run_worker_first": true
  }
}
